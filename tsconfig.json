{
  "include": ["src"],
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDir": "src",
    "paths": {
      "@sideko-inc/stripe": ["src/index.ts"],
      "@sideko-inc/stripe/*": ["src/*"]
    },

    // 🧠 COMMENT OUT IF NOT NEEDED
    "declaration": false,
    "declarationDir": "./dist",

    // ✅ Still safe but lighter
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    // 🧹 Optional: relax some memory-intensive checks
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,

    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
